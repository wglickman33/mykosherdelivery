# Frontend Environment Variables
# Copy this to .env and fill in your actual values

# API Configuration (local backend)
VITE_API_BASE_URL=http://localhost:3001/api
# Production: https://mykosherdelivery-659274a65452.herokuapp.com/api

# Stripe (Frontend - Publishable Key Only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Google Places API
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# EmailJS
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_order_confirmation_template_id
VITE_EMAILJS_RESET_TEMPLATE_ID=your_password_reset_template_id
VITE_EMAILJS_NH_BILLING_TEMPLATE_ID=template_q1irb2l
